# Supabase (API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Postgres used by Spring/Flyway (Supabase dashboard > Connect)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_DATABASE=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Optional override (takes precedence over SUPABASE_DB_*)
# DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
# DB_USERNAME=
# DB_PASSWORD=
# Backend security
INGEST_API_KEY=change-me
REPORTER_HASH_PEPPER=change-me
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:4173
# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8080
