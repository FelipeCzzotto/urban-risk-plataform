# Backend security
INGEST_API_KEY=change-me
REPORTER_HASH_PEPPER=change-me
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Mobile
EXPO_PUBLIC_API_URL=http://localhost:8080
